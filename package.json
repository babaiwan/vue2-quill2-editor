{
  "name": "vue2-quill2-editor",
  "version": "1.0.68",
  "description": "A rich text editor component for Vue 2 based on Quill 2, supporting tables, image upload/resize, color picker and custom HTML blocks.",
  "main": "src/index.js",
  "unpkg": "dist/index.js",
  "jsdelivr": "dist/index.js",
  "files": [
    "src",
    "dist/index.js",
    "dist/*.svg",
    "dist/*.txt",
    "README.md"
  ],
  "scripts": {
    "build": "webpack --config webpack.config.js --mode production",
    "serve": "webpack serve --config webpack.config.js",
    "prepack": "npm run build",
    "login:npm": "npm login --registry=https://registry.npmjs.org/",
    "publish:npm": "npm publish --registry=https://registry.npmjs.org/"
  },
  "keywords": [
    "vue",
    "vue2",
    "quill",
    "quill2",
    "editor",
    "rich-text-editor",
    "wysiwyg",
    "html-editor"
  ],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "highlight.js": "^11.10.0",
    "quill": "^2.0.2",
    "v-viewer": "^1.6.4",
    "vue": "^2.7.16",
    "vue-template-compiler": "^2.7.16"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "axios": "^1.7.7",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.0",
    "rollup": "^4.22.4",
    "rollup-plugin-vue": "^6.0.0",
    "style-loader": "^4.0.0",
    "vue-loader": "^15.11.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "vcolorpicker": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/babaiwan/vue2-quill2-editor.git"
  }
}
